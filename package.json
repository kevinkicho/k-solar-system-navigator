{
  "name": "helios-solar-system-navigator",
  "version": "1.0.0",
  "description": "HELIOS — industrial preliminary mission-design workstation (browser). Not flight-certified.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "agent": "node scripts/helios-agent.mjs",
    "test": "npm run test:physics && npm run test:server && npm run test:agent && npm run test:agent-contract",
    "test:physics": "node tests/run_physics.mjs",
    "test:server": "node tests/server_path_jail.mjs",
    "test:agent": "node tests/agent_api.mjs",
    "test:agent-contract": "node tests/onboard_snapshot_contract.mjs",
    "test:nearest": "node tests/nearest_feasible.mjs",
    "test:ui": "node tests/ui_smoke.mjs",
    "test:ui:ci": "node tests/ci_ui.mjs",
    "test:ui:multileg": "node tests/ci_multileg.mjs",
    "precommit": "npm test && npm run test:ui:ci && npm run test:ui:multileg && npm run check:hosting-ignore",
    "ci": "npm run precommit",
    "release:check": "node scripts/release-check.mjs",
    "build:stars": "node scripts/build-stars.mjs",
    "build:ephemeris": "node scripts/build-ephemeris-samples.mjs",
    "build:ephemeris:spice": "python scripts/build-ephemeris-from-spice.py",
    "build:ephemeris:moons": "node scripts/build-moon-samples.mjs",
    "build:ephemeris:mars-moons": "python scripts/build-mars-moons-spice.py",
    "build:ephemeris:dense": "python scripts/build-dense-spk-pack.py --all-tier-a",
    "build:ephemeris:dense-b": "python scripts/build-dense-spk-pack.py --all-tier-b",
    "budget:dense-spice": "node scripts/dense-spice-budget.mjs",
    "upload:dense-spk": "node scripts/upload-dense-spk-firebase.mjs",
    "smoke:live": "node scripts/live-smoke.mjs",
    "smoke:build-sha": "node scripts/build-sha-smoke.mjs",
    "kernels:download": "python scripts/download-kernels.py",
    "kernels:download:tier-b": "python scripts/download-kernels.py --tier-b",
    "firebase:smoke": "node scripts/firebase-admin-smoke.mjs",
    "firebase:seed": "node scripts/firebase-admin-seed.mjs",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:prepare": "node web/scripts/prepare-spa-assets.mjs",
    "deploy:apphosting": "npm --prefix web run build && npx -y firebase-tools@latest deploy --only apphosting --project k-solar-system-navigator",
    "deploy:hosting": "npm run web:prepare && npx -y firebase-tools@latest deploy --only hosting --project k-solar-system-navigator",
    "deploy:all": "npm run deploy:hosting && npm run deploy:apphosting",
    "check:hosting-ignore": "node scripts/check-hosting-ignore.mjs"
  },
  "devDependencies": {
    "firebase-admin": "^13.10.0",
    "playwright": "^1.59.1",
    "puppeteer": "^24.42.0"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "three": "^0.164.0"
  }
}
