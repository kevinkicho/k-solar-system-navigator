{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "apphosting": {
    "backendId": "helios",
    "rootDir": "web",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "functions",
      "tests",
      "docs",
      ".agents",
      ".claude"
    ]
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "web/**",
      "tests/**",
      "docs/**",
      "scripts/**",
      "public/**",
      ".agents/**",
      ".claude/**",
      "*.md",
      "package.json",
      "package-lock.json",
      "server.js",
      "LICENSE",
      "hyg_v42.csv",
      "trajectory-calculator.js",
      "firestore.rules",
      "firestore.indexes.json",
      "database.rules.json",
      "storage.rules",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*firebase-adminsdk*.json",
      "skills-lock.json"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|mjs|css|json|wasm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=3600"
          }
        ]
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
