{
  "name": "helios-apphosting",
  "version": "1.0.0",
  "private": true,
  "description": "HELIOS Mission Design — Firebase App Hosting (Next.js SSR shell + client SPA)",
  "scripts": {
    "prepare:spa": "node scripts/prepare-spa-assets.mjs",
    "prebuild": "node scripts/prepare-spa-assets.mjs",
    "predev": "node scripts/prepare-spa-assets.mjs",
    "dev": "next dev -p 3000",
    "build": "node scripts/prepare-spa-assets.mjs && next build",
    "start": "next start",
    "lint": "echo skip",
    "postinstall": "node scripts/prepare-spa-assets.mjs || true"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
