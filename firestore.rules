rules_version = '2';

// HELIOS — owner-only user data. Web config is public; rules are access control.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Profile + all nested data (plans, prefs, …)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Public product catalog (dense SPICE pack index). Read-only for clients.
    // Written by Admin SDK / CI (service account), not browser.
    match /helios/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
