{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "lastRoute": {
          ".validate": "newData.hasChildren(['o', 'd', 'at'])"
        },
        "windowCampaigns": {
          "$cid": {
            ".validate": "newData.hasChildren(['origin', 'dest', 'shortlist', 'at']) && newData.child('at').isNumber() && newData.child('origin').isString() && newData.child('dest').isString()"
          }
        }
      }
    }
  }
}
